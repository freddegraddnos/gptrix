{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://miscwhygqrhbnuqzqnzu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "ink-vision-ar",
      "version": "0.1.0",
      "title": "Ink Vision AR"
    },
    "tools": [
      {
        "name": "list_studios",
        "title": "List approved studios",
        "description": "List approved InkSimulator tattoo studios, optionally filtered by city, with booking links.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "city": {
              "description": "Optional city to filter by.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "my_bookings",
        "title": "My bookings",
        "description": "List the signed-in user's tattoo booking requests and their status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "book_studio",
        "title": "Send a booking request to a studio",
        "description": "Send a tattoo booking request from the signed-in user to an approved InkSimulator studio (use the handle from list_studios). The request appears in the studio's panel and the studio and user are notified. The user must have confirmed they are 18+ in their InkSimulator profile.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "handle": {
              "type": "string",
              "minLength": 1,
              "description": "Studio handle from list_studios bookingUrl (/<handle>/book)."
            },
            "preferredDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Preferred date, YYYY-MM-DD."
            },
            "preferredTime": {
              "description": "Preferred time, HH:MM.",
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            },
            "bodyArea": {
              "type": "string",
              "maxLength": 80
            },
            "sizeCm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "note": {
              "description": "Description of the tattoo idea.",
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "handle",
            "preferredDate"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
